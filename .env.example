# Cursor (required for Live mode on the API host)
CURSOR_API_KEY=
# CURSOR_MODEL=composer-2.5

# API port (Render sets PORT automatically)
# PORT=8787

# Frontend — set this in Vercel for production
# VITE_API_URL=https://hive-efc7.onrender.com

# Optional extra GitHub repos for the picker (comma-separated)
# HIVE_REPOS=https://github.com/you/app,you/other-repo

# GitHub sign-in (required for app access)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=          # exact secret, no quotes
# Where the browser lives AFTER sign-in (must be your real web URL in prod)
# HIVE_APP_URL=http://localhost:5173
# Prod example: HIVE_APP_URL=https://your-app.vercel.app
# Callback MUST match the GitHub OAuth App “Authorization callback URL” exactly
# Local:  GITHUB_CALLBACK_URL=http://localhost:8787/api/auth/github/callback
# Prod:   GITHUB_CALLBACK_URL=https://hive-efc7.onrender.com/api/auth/github/callback
# HIVE_API_URL=https://hive-efc7.onrender.com
