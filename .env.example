# Cursor (required for Live mode on the API host)
CURSOR_API_KEY=
# CURSOR_MODEL=composer-2.5

# API port (Render sets PORT automatically)
# PORT=8787

# Frontend — set this in Vercel for production
# VITE_API_URL=https://hive-efc7.onrender.com

# Optional extra GitHub repos for the picker (comma-separated)
# HIVE_REPOS=https://github.com/you/app,you/other-repo

# GitHub sign-in (required for app access)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=          # exact secret, no quotes
# Optional; defaults to GITHUB_CLIENT_SECRET. Signs session cookies (survives Render restarts).
# HIVE_SESSION_SECRET=
# Where the browser lives AFTER sign-in (must be your real web URL in prod)
# HIVE_APP_URL=http://localhost:5173
# Prod example: HIVE_APP_URL=https://your-app.vercel.app
# Callback MUST be the app host (Vercel/Vite), not onrender.com — matches GitHub OAuth App
# Local:  GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback
# Prod:   GITHUB_CALLBACK_URL=https://your-app.vercel.app/api/auth/github/callback
# (Usually omit — defaults to ${HIVE_APP_URL}/api/auth/github/callback)
# HIVE_API_URL=https://hive-efc7.onrender.com

# Jira (optional) — pick a user story as the Hive goal
# Create an API token: https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=bot@your-company.com
# JIRA_API_TOKEN=
# Optional: limit to one project key
# JIRA_PROJECT=PROJ
# Optional: override default JQL (all open Stories, not Done)
# JIRA_JQL=
# Optional: custom field id for acceptance criteria (e.g. customfield_10000)
# JIRA_AC_FIELD=
